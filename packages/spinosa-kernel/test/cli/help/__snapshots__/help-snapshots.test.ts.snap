exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode upgrade --help 1`] = `
"spinosa upgrade [target]

check for and install Spinosa updates

Positionals:
  target  target version (alias: --version)                                                 [string]

Options:
  -h, --help             show help                                                         [boolean]
      --print-logs       print logs to stderr                                              [boolean]
      --log-level        log level              [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --verbose          print boot diagnostics to stderr                                  [boolean]
      --pure             run without external plugins                                      [boolean]
      --version          target version to install (alias of the positional target)         [string]
      --channel          release channel (stable or beta)       [string] [choices: "stable", "beta"]
      --yes              skip confirmation prompts                                         [boolean]
      --reinstall        reinstall the target version even if it matches the installed version
                                                                                           [boolean]
      --allow-downgrade  permit downgrading to an older version                            [boolean]
      --check            check for updates without installing                              [boolean]"
`;

exports[`opencode CLI help-text snapshots every documented command emits stable help text: opencode uninstall --help 1`] = `
"spinosa uninstall

remove the Spinosa framework runtime and selected application data

Options:
  -h, --help         show help                                                             [boolean]
  -v, --version      show version number                                                   [boolean]
      --print-logs   print logs to stderr                                                  [boolean]
      --log-level    log level                  [string] [choices: "DEBUG", "INFO", "WARN", "ERROR"]
      --verbose      print boot diagnostics to stderr                                      [boolean]
      --pure         run without external plugins                                          [boolean]
  -y, --yes          skip confirmation prompts                            [boolean] [default: false]
  -f, --force        alias for --yes                                      [boolean] [default: false]
  -c, --keep-config  keep XDG configuration files                         [boolean] [default: false]
  -d, --keep-data    keep XDG session data and state                      [boolean] [default: false]
      --dry-run      show what would be removed                           [boolean] [default: false]"
`;

