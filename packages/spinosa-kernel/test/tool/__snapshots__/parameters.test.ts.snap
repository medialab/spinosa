exports[`tool parameters JSON Schema (wire shape) write_report 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "conclusions": {
      "description": "Critical reflection: what we expected vs what we found, which assumptions held or broke, implications.",
      "type": "string",
    },
    "filename": {
      "description": "Report filename: NN_{topic-slug}.md (e.g. 05_coastal-erosion-normandy.md). Must start with a 2-digit number followed by an underscore.",
      "type": "string",
    },
    "goal": {
      "description": "What the research aimed to answer",
      "type": "string",
    },
    "pipeline": {
      "description": "Agent chain, e.g. 'searcher → writer → verifier → evaluator'",
      "type": "string",
    },
    "query": {
      "description": "Original user query",
      "type": "string",
    },
    "report": {
      "description": "Main body: evidence, interpretation, analysis, patterns. Structure freely with H2/H3.",
      "type": "string",
    },
    "reproducibility": {
      "properties": {
        "agents": {
          "description": "Agent chain",
          "type": "string",
        },
        "filesRead": {
          "description": "Files read",
          "type": "number",
        },
        "filesScanned": {
          "description": "Files scanned",
          "type": "number",
        },
        "gaps": {
          "description": "Coverage gaps",
          "type": "string",
        },
        "globPatterns": {
          "description": "Glob patterns used",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "grepPatterns": {
          "description": "Grep patterns used",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "mapsAccessed": {
          "description": "Number of maps accessed",
          "type": "number",
        },
        "searchRounds": {
          "description": "Search rounds",
          "type": "number",
        },
        "sources": {
          "description": "Source paths referenced",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "tags": {
          "description": "Keywords/terms used",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "required": [
        "agents",
        "sources",
      ],
      "type": "object",
    },
    "scope": {
      "description": "One-line description of the report scope",
      "type": "string",
    },
    "serendipity": {
      "description": "Hidden connections and alternative viewpoints. Omit entirely when serendippo did not run.",
      "type": "string",
    },
    "status": {
      "description": "Verification status (default: draft)",
      "enum": [
        "draft",
        "pass",
        "pass_with_corrections",
      ],
      "type": "string",
    },
    "title": {
      "description": "H1 headline for the report (mirrors the goal statement)",
      "type": "string",
    },
    "tldr": {
      "description": "Short natural-language answer, 1–3 sentences",
      "type": "string",
    },
  },
  "required": [
    "filename",
    "title",
    "scope",
    "pipeline",
    "query",
    "goal",
    "tldr",
    "report",
    "conclusions",
    "reproducibility",
  ],
  "type": "object",
}
`;
