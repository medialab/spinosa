exports[`tool parameters JSON Schema (wire shape) spinosa_map 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "action": {
      "description": "begin scaffold, write_extraction, write_map, check, or cover",
      "enum": [
        "begin",
        "write_extraction",
        "write_map",
        "check",
        "cover",
      ],
      "type": "string",
    },
    "batchId": {
      "description": "Descriptive kebab batch slug for extraction actions",
      "type": "string",
    },
    "body": {
      "description": "Map prose with wikilinks. No tables.",
      "type": "string",
    },
    "files": {
      "description": "raw/ paths for begin",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "links": {
      "description": "Wikilink targets that must appear in the map",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "mapKind": {
      "description": "Map kind; inferred from path when omitted",
      "enum": [
        "hub",
        "group",
        "theme",
      ],
      "type": "string",
    },
    "mapPath": {
      "description": "maps/... path for write_map",
      "type": "string",
    },
    "mode": {
      "description": "write_map behavior when the file exists (default replace)",
      "enum": [
        "create",
        "replace",
        "enrich",
      ],
      "type": "string",
    },
    "packets": {
      "description": "Structured packets for write_extraction",
      "items": {
        "properties": {
          "concepts": {
            "description": "Dictionary canonical terms",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "connections": {
            "description": "Related raw/ paths or none",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
          "filename": {
            "description": "File basename",
            "type": "string",
          },
          "language": {
            "description": "en or fr or the file language",
            "type": "string",
          },
          "passages": {
            "description": "2-5 key passages",
            "items": {
              "properties": {
                "lines": {
                  "description": "Line range such as L12-L15",
                  "type": "string",
                },
                "path": {
                  "description": "raw/ path for this quote",
                  "type": "string",
                },
                "quote": {
                  "description": "Short grounded quote or close paraphrase",
                  "type": "string",
                },
              },
              "required": [
                "quote",
              ],
              "type": "object",
            },
            "type": "array",
          },
          "path": {
            "description": "raw/ relative path",
            "type": "string",
          },
          "sourceType": {
            "description": "Inferred source type",
            "type": "string",
          },
          "status": {
            "description": "extracted (default) or unreadable",
            "enum": [
              "extracted",
              "unreadable",
            ],
            "type": "string",
          },
          "summary": {
            "description": "3-5 sentence content-grounded summary",
            "type": "string",
          },
          "tags": {
            "description": "Obsidian tags including #concept/ #type/ #group/",
            "items": {
              "type": "string",
            },
            "type": "array",
          },
        },
        "required": [
          "filename",
          "path",
        ],
        "type": "object",
      },
      "type": "array",
    },
    "relativePath": {
      "description": "Existing extraction or map path for check/cover",
      "type": "string",
    },
    "tags": {
      "description": "Obsidian tags placed under the H1",
      "items": {
        "type": "string",
      },
      "type": "array",
    },
    "title": {
      "description": "Map H1 title",
      "type": "string",
    },
    "workspacePath": {
      "description": "Workspace root override (defaults to session directory)",
      "type": "string",
    },
  },
  "required": [
    "action",
  ],
  "type": "object",
}
`;

