          "items": {
            "type": "string",
          },
          "type": "array",
        },
        "kind": {
          "description": "Multi-variable health grid",
          "enum": [
            "status_matrix",
          ],
          "type": "string",
        },
        "rows": {
          "description": "Rows of status cells matching columns",
          "items": {
            "properties": {
              "cells": {
                "description": "One cell per column",
                "items": {
                  "description": "pass, warning, fail, pending, or active",
                  "enum": [
                    "pass",
                    "warning",
                    "fail",
                    "pending",
                    "active",
                  ],
                  "type": "string",
                },
                "type": "array",
              },
              "label": {
                "description": "Row label",
                "type": "string",
              },
            },
            "required": [
              "label",
              "cells",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "source": {
          "description": "Source path or description",
          "type": "string",
        },
        "title": {
          "description": "Figure title inside the top border",
          "type": "string",
        },
        "units": {
          "description": "Units for the plotted values",
          "type": "string",
        },
      },
      "required": [
        "kind",
        "title",
        "caption",
        "source",
        "units",
        "columns",
        "rows",
      ],
      "type": "object",
    },
  ],
}
`;

