{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "spinosa",
  "private": true,
  "version": "1.1.0-beta.10",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run --cwd packages/spinosa-cli src/index.ts",
    "spinosa": "bun run --cwd packages/spinosa-cli src/index.ts",
    "postinstall": "bun run --cwd packages/core fix-node-pty",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/sdk typecheck && bun run --cwd packages/tui typecheck && bun run --cwd packages/spinosa-kernel typecheck && bun run --cwd packages/spinosa-core typecheck && bun run --cwd packages/spinosa-runtime typecheck && bun run --cwd packages/spinosa-harness typecheck && bun run --cwd packages/spinosa-cli typecheck",
    "typecheck:all": "bun scripts/typecheck-all.ts",
    "test:core": "bun run --cwd packages/spinosa-core test test/bun-launch.test.ts test/checksums.test.ts test/version.test.ts test/preflight.test.ts test/channels.test.ts test/yaml-config.test.ts test/upgrade-network.test.ts test/upgrade-errors.test.ts test/uninstall.test.ts test/version-cache.test.ts test/fs-truncate.test.ts test/distribution.test.ts ../../scripts/release/github.test.ts ../../scripts/release/bump.test.ts ../../scripts/release/lib.test.ts ../../scripts/set-version.test.ts",
    "test:tui": "bun run --cwd packages/tui test:spinosa",
    "quality": "bun scripts/quality-release.ts",
    "quality:report": "bun scripts/quality-report.ts",
    "quality:baseline": "bun scripts/quality-report.ts --write-baseline",
    "quality:report:check": "bun scripts/quality-report.ts --check",
    "quality:coverage": "bun scripts/quality-coverage.ts",
    "quality:coverage:check": "bun scripts/quality-coverage.ts --check",
    "quality:mutation": "bun scripts/quality-mutation.ts",
    "quality:generated": "bun scripts/check-generated.ts && bun run --cwd packages/core migration --check",
    "quality:full": "bun scripts/typecheck-all.ts && bun run lint:deps && bun run lint:unused && bun run quality:generated && bun run lint:syncpack && bun run lint:shell && bun run test:core && bun run test:tui && bun run test:installer",
    "quality:binary": "bun scripts/quality-binary.ts",
    "smoke": "bun scripts/smoke-install.ts",
    "build:binaries": "bun scripts/build-release-binaries.ts",
    "build:binaries:host": "bun scripts/build-release-binaries.ts --host-only",
    "release": "bun scripts/release/index.ts",
    "release:validate": "bun scripts/release/index.ts validate",
    "release:sync-version": "bun scripts/set-version.ts",
    "release:resume": "bun scripts/release/index.ts resume",
    "release:republish": "bun scripts/release/index.ts publish",
    "release:beta:patch": "bun scripts/release/index.ts beta patch",
    "release:beta:minor": "bun scripts/release/index.ts beta minor",
    "release:stable:patch": "bun scripts/release/index.ts stable patch",
    "release:stable:minor": "bun scripts/release/index.ts stable minor",
    "release:stable:major": "bun scripts/release/index.ts stable major",
    "patches:generate": "bun scripts/generate-patches-md.ts",
    "lint:shell": "bash scripts/lint-shell.sh",
    "test:installer": "bats tests/installer",
    "lint:deps": "depcruise 'packages/*/src' script --config .dependency-cruiser.cjs",
    "lint:unused": "knip --no-config-hints",
    "lint:syncpack": "syncpack lint --dependency-types prod,dev"
  },
