exports[`tool parameters JSON Schema (wire shape) spinosa_frame 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cleanedPrompt": {
      "description": "The request text, stripped of preamble",
      "type": "string",
    },
    "decision": {
      "description": "Orchestrated intent dimensions from spinosa_route",
      "properties": {
        "confidence": {
          "type": "number",
        },
        "coverage": {
          "enum": [
            "opportunistic",
            "sufficient",
            "representative",
            "exhaustive",
          ],
          "type": "string",
        },
        "evaluation": {
          "enum": [
            "always",
            "on_failure",
            "sampled",
            "never",
          ],
          "type": "string",
        },
        "mode": {
          "enum": [
            "orchestrated",
          ],
          "type": "string",
        },
        "mutation": {
          "enum": [
            "none",
            "propose",
            "allowed",
            "requires_approval",
          ],
          "type": "string",
        },
        "operation": {
          "enum": [
            "research",
            "corpus",
            "maintenance",
            "meta",
          ],
          "type": "string",
        },
        "outputs": {
          "items": {
            "enum": [
              "chat",
              "report",
              "table",
              "visualization",
              "map",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "reason": {
          "type": "string",
        },
        "scope": {
          "enum": [
            "local",
            "subset",
            "corpus_wide",
          ],
          "type": "string",
        },
        "strategy": {
          "type": "string",
        },
        "verification": {
          "enum": [
            "none",
            "normal",
            "strict",
          ],
          "type": "string",
        },
      },
      "required": [
        "mode",
        "operation",
        "strategy",
        "scope",
        "coverage",
        "outputs",
        "mutation",
        "verification",
        "evaluation",
        "reason",
        "confidence",
      ],
      "type": "object",
    },
    "workspacePath": {
      "description": "Workspace root override (defaults to session directory)",
      "type": "string",
    },
  },
  "required": [
    "cleanedPrompt",
    "decision",
  ],
  "type": "object",
}
`;

