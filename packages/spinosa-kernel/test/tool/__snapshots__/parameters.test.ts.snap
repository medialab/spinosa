exports[`tool parameters JSON Schema (wire shape) spinosa_frame 1`] = `
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "cleanedPrompt": {
      "description": "The request, with extra preamble stripped",
      "type": "string",
    },
    "decision": {
      "description": "The JSON spinosa_route returned. Pass it through unchanged.",
      "properties": {
        "confidence": {
          "type": "number",
        },
        "coverage": {
          "enum": [
            "opportunistic",
            "sufficient",
            "representative",
            "exhaustive",
          ],
          "type": "string",
        },
        "evaluation": {
          "enum": [
            "always",
            "on_failure",
            "sampled",
            "never",
          ],
          "type": "string",
        },
        "mode": {
          "enum": [
            "orchestrated",
          ],
          "type": "string",
        },
        "mutation": {
          "enum": [
            "none",
            "propose",
            "allowed",
            "requires_approval",
          ],
          "type": "string",
        },
        "operation": {
          "enum": [
            "research",
            "corpus",
            "maintenance",
            "meta",
          ],
          "type": "string",
        },
        "outputs": {
          "items": {
            "enum": [
              "chat",
              "report",
              "table",
              "visualization",
              "map",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "reason": {
          "type": "string",
        },
        "scope": {
          "enum": [
            "local",
            "subset",
            "corpus_wide",
          ],
          "type": "string",
        },
        "strategy": {
          "description": "Short plan name from spinosa_route. One token, not a sentence or a -> chain.",
          "enum": [
            "targeted_evidence",
            "contextual_synthesis",
            "corpus_census",
            "comparative_synthesis",
            "hypothesis_test",
            "exploratory_discovery",
            "startup_index",
            "add_sources",
            "reindex",
            "remap",
            "enrich_metadata",
            "integrity_check",
            "cleanup_proposal",
            "cleanup_apply",
            "repair",
            "coverage_audit",
            "route_audit",
            "framework_evolution",
          ],
          "type": "string",
        },
        "verification": {
          "enum": [
            "none",
            "normal",
            "strict",
          ],
          "type": "string",
        },
      },
      "required": [
        "mode",
        "operation",
        "strategy",
        "scope",
        "coverage",
        "outputs",
        "mutation",
        "verification",
        "evaluation",
        "reason",
        "confidence",
      ],
      "type": "object",
    },
    "workspacePath": {
      "description": "Workspace root override (defaults to session directory)",
      "type": "string",
    },
  },
  "required": [
    "cleanedPrompt",
    "decision",
  ],
  "type": "object",
}
`;

