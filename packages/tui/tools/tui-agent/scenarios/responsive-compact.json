{
  
  "name": "responsive-compact",
  "description": "Verify responsive layout transitions: desktop -> compact -> narrow. Check home and session views adapt correctly.",
  "adapter": "../adapters/spinosa.ts",
  "terminal": { "width": 100, "height": 50 },
  "fixture": {
    "workspace": { "name": "responsive-workspace", "setupStatus": "workspace_started" },
    "sessions": [
      { "id": "ses_resp", "title": "Responsive layout test", "directory": "$WORKSPACE", "updated": 100 }
    ],
    "responses": [
      { "path": "/global/config", "body": { "autoupdate": "notify" } },
      { "path": "/file", "body": [] },
      { "path": "/session/ses_resp/children", "body": [] },
      { "path": "/session/ses_resp/diff", "body": [] },
      { "path": "/session/ses_resp/todo", "body": [] },
      { "path": "/session/ses_resp/permission", "body": [] },
      { "path": "/session/ses_resp/question", "body": [] },
      { "path": "/session/ses_resp/message", "body": [] },
      { "path": "/session/ses_resp/part", "body": [] }
    ]
  },
  "steps": [
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 8000 },
    { "action": "capture", "name": "desktop-home" },

    { "action": "resize", "width": 100, "height": 20 },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },
    { "action": "capture", "name": "compact-home" },

    { "action": "resize", "width": 68, "height": 50 },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },
    { "action": "capture", "name": "narrow-home" },

    { "action": "resize", "width": 100, "height": 50 },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },
    { "action": "capture", "name": "restored-desktop" },

    { "action": "type", "text": "/session" },
    { "action": "key", "key": "RETURN" },
    { "action": "waitForText", "text": "Responsive layout test", "timeoutMs": 5000 },
    { "action": "clickText", "text": "Responsive layout test" },
    { "action": "waitForText", "text": "Export", "timeoutMs": 5000 },

    { "action": "resize", "width": 100, "height": 20 },
    { "action": "capture", "name": "session-compact" },

    { "action": "resize", "width": 66, "height": 50 },
    { "action": "capture", "name": "session-narrow" },

    { "action": "resize", "width": 100, "height": 50 },

    { "action": "clickText", "text": "< Workspace home" },
    { "action": "waitForText", "text": "Describe the task", "timeoutMs": 5000 },

    { "action": "clickText", "text": "Visualizer" },
    { "action": "waitForText", "text": "Conversation graphs", "timeoutMs": 8000 },
    { "action": "resize", "width": 100, "height": 20 },
    { "action": "capture", "name": "visualizer-compact" },
    { "action": "resize", "width": 100, "height": 50 }
  ]
}
